# Copy to backend/.env and fill in the values. Never commit the real .env.
#   cp backend/.env.example backend/.env

# --- Django ------------------------------------------------------------
# 1 for local development, 0 in production.
DJANGO_DEBUG=1
# Production: a long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Production: your domain(s), comma-separated, e.g. iptds.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: https://your-domain (needed for the Django admin login over HTTPS)
CSRF_TRUSTED_ORIGINS=
# Only needed when the React app is served from a different domain than the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_TIME_ZONE=Asia/Kathmandu
# HSTS max-age in seconds once HTTPS works (start 3600, later 31536000).
DJANGO_HSTS_SECONDS=3600

# --- PostgreSQL --------------------------------------------------------
POSTGRES_DB=iptds
POSTGRES_USER=iptds
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Optional ----------------------------------------------------------
# READINESS_THRESHOLD=70
# THROTTLE_LOGIN=10/min
# THROTTLE_REGISTER=5/hour
# DJANGO_LOG_LEVEL=INFO
# Path of Django's built-in admin site (the React app uses /admin for its own screens).
# DJANGO_ADMIN_URL=django-admin/
